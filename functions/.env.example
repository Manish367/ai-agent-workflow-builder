# Hasura connection (used by the functions to talk back to Hasura as admin).
# On nhost cloud, custom env var names can't start with NHOST_/HASURA_/AUTH_/
# STORAGE_/POSTGRES_, so the endpoint uses a plain name; the admin secret reuses
# nhost's own system-provided NHOST_ADMIN_SECRET (already injected, no need to set it here).
GRAPHQL_ENDPOINT=http://localhost:8080/v1/graphql
NHOST_ADMIN_SECRET=nhost-admin-secret

# Shared secrets Hasura is configured to send with every Action/Event/Cron call —
# generate any random string for these, put the same value in both places.
ACTION_SECRET=change-me-action-secret
EVENT_TRIGGER_SECRET=change-me-event-secret

# Base URL where these functions are reachable from Hasura.
# Local nhost dev:  http://local.functions.nhost.run:1337
# nhost cloud:       https://<subdomain>.functions.<region>.nhost.run
ACTIONS_BASE_URL=http://local.functions.nhost.run:1337

# LLM provider for llm_call steps. Leave LLM_API_KEY unset to use the disclosed stub.
LLM_PROVIDER=stub
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# notify step outbox. Leave unset to log to console instead of actually sending.
SLACK_WEBHOOK_URL=
